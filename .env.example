# Copia questo file in `.env` per cambiare le impostazioni di sviluppo. Il file `.env` non va mai in git.
# Tutte le righe sono facoltative: senza `.env` Filmzy usa i valori predefiniti.

# Porta del server locale (predefinita: 3001). L'interfaccia di sviluppo la raggiunge con un proxy.
# FILMZY_API_PORT=3001

# Chiavi dei servizi AI: servono solo da M1, per le prove vere. Con il programma installato si
# inseriscono da Impostazioni, non da qui.
# ANTHROPIC_API_KEY=
# FAL_KEY=

# Prova con un LLM vero (T1.1): con la chiave presente, `pnpm --filter @filmzy/troupe test`
# esegue anche quella prova, che costa qualche centesimo. Senza chiave viene saltata.
# Gli id dei modelli nel seme sono da verificare (T1.7): se il tuo è diverso, scrivilo qui.
# FILMZY_TEST_PROVIDER_MODEL=
