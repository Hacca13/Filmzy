{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // L'interfaccia gira nel browser e la compila Vite: serve un'altra risoluzione dei moduli
    // rispetto ai package Node (che usano NodeNext).
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
