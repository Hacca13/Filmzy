{
  "name": "@filmzy/media",
  "version": "0.0.0",
  "private": true,
  "description": "Montaggio e file multimediali con ffmpeg: fotogrammi dai video (e, più avanti, mix ed esportazione)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "dejavu-fonts-ttf": "2.37.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2"
  }
}
