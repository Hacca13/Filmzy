{
  "name": "@filmzy/troupe",
  "version": "0.0.0",
  "private": true,
  "description": "Livello AI: configurazione della troupe, validazione, router, adapter e scontrini",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@filmzy/contracts": "workspace:*",
    "liquidjs": "10.21.1",
    "yaml": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2"
  }
}
